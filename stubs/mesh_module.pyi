from typing import overload
import numpy as np
from vec_module import Vec3f, Vec3i, Vertex, FaceData


# Re-export FaceData as done in the C++ module
__all__ = ["Mesh", "FaceData"]

class Mesh:
    def __init__(self) -> None: ...

    @overload
    def add_vertex(self, x: float, y: float, z: float) -> int: ...
    @overload
    def add_vertex(self, pos: Vec3f, block_light: int = 255, sky_light: int = 0) -> int: ...
    @overload
    def add_vertex(self, vertex: Vertex) -> int: ...

    @overload
    def add_triangle(self, i0: int, i1: int, i2: int, face: FaceData) -> None: ...
    @overload
    def add_triangle(self, indices_vec: Vec3i, face: FaceData) -> None: ...
    @overload
    def add_triangle(self, i0: int, i1: int, i2: int) -> None: ...
    @overload
    def add_triangle(self, indices_vec: Vec3i) -> None: ...

    def clear(self) -> None: ...

    light_revision: int

    def vertex_light(self, index: int) -> int: ...

    @property
    def vertex_light_np(self) -> np.ndarray: ...

    @property
    def vertex_count(self) -> int: ...

    @property
    def index_count(self) -> int: ...

    @property
    def triangle_count(self) -> int: ...

    @property
    def face_count(self) -> int: ...

    @property
    def vertices_np(self) -> np.ndarray: ...

    @property
    def faces_np(self) -> np.ndarray: ...

    @property
    def face_colors_np(self) -> np.ndarray: ...

    def __repr__(self) -> str: ...


