from typing import Optional, overload
from image_module import Image


class Texture:
    id: int
    name: str
    images: list[Image]
    anim_data: int

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, name: str) -> None: ...
    @overload
    def __init__(self, images: list[Image], name: str) -> None: ...

    def get_frame_count_bit(self) -> int: ...
    def get_tick_interval_bit(self) -> int: ...
    def set_animation(self, frame_count_bit: int, tick_interval_bit: int) -> None: ...
    def get_current_frame(self, current_tick: int) -> Image: ...
    
    def __repr__(self) -> str: ...


class TextureManager:
    def __init__(self) -> None: ...
    
    def register_texture(self, texture: Texture) -> int: ...
    def get_layer_id(self, texture_id: int) -> int: ...
    def get_texture(self, layer_id: int) -> Optional[Texture]: ...
    def get_texture_by_name(self, name: str) -> Optional[Texture]: ...
    def get_layer_id_by_name(self, name: str) -> int: ...
    def get_textures(self) -> list[Texture]: ...
    def size(self) -> int: ...
    def has_texture(self, texture_id: int) -> bool: ...
    def get_layer_and_anim(self, texture_id: int) -> tuple[int, int]: ...
    
    def __repr__(self) -> str: ...


class TextureBlocksManager:
    def __init__(self) -> None: ...
    
    def register_texture(self, texture: Texture) -> int: ...
    def get_texture_by_name(self, name: str) -> Optional[Texture]: ...
    def get_texture_id_by_name(self, name: str) -> int: ...
    def get_layer_and_anim(self, texture_id: int) -> tuple[int, int]: ...
    def size(self) -> int: ...
    def get_total_layers(self) -> int: ...
    
    def __repr__(self) -> str: ...


STANDARD_BLOCK_TEXTURE_SIZE: int


