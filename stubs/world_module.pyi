from typing import Callable, Optional, Tuple

from block_module import Block, BlockManager
from chunk_module import Chunk
from item_module import Inventory, ItemEntity, ItemStack
from light_engine_module import LightEngine
from mesh_module import Mesh
from texture_module import TextureBlocksManager, TextureManager
from vec_module import Vec2i, Vec3f, Vec3i


class World:
    def __init__(
        self,
        block_mgr: BlockManager,
        tex_blocks_mgr: TextureBlocksManager,
        tex_mgr: TextureManager,
    ) -> None: ...

    # Управление чанками
    def get_chunk(self, chunk_pos: Vec2i) -> Optional[Chunk]: ...
    def set_chunk(self, chunk_pos: Vec2i, chunk: Chunk) -> None: ...
    def has_chunk(self, chunk_pos: Vec2i) -> bool: ...
    def remove_chunk(self, chunk_pos: Vec2i) -> None: ...

    # Преобразование координат
    @staticmethod
    def world_to_chunk_coords(world_pos: Vec3i) -> Vec2i: ...
    @staticmethod
    def world_to_local_coords(world_pos: Vec3i) -> Vec3i: ...

    # Доступ к блокам
    def get_block(self, world_pos: Vec3i) -> Optional[Block]: ...
    def get_block_with_nbt(self, world_pos: Vec3i) -> Tuple[Optional[Block], int]: ...
    def set_block(self, world_pos: Vec3i, block: Block) -> None: ...
    def remove_block(self, world_pos: Vec3i) -> None: ...
    def get_block_id(self, world_pos: Vec3i) -> int: ...

    # NBT: 16-битное число, интерпретируемое типом блока
    def get_nbt(self, world_pos: Vec3i) -> int: ...
    def set_nbt(self, world_pos: Vec3i, nbt: int) -> bool: ...

    # Items в мире (временно на уровне World)
    def spawn_item_entity(
        self,
        stack: ItemStack,
        position: Vec3f,
        velocity: Vec3f = ...,
    ) -> int: ...
    def remove_item_entity(self, entity_id: int) -> bool: ...
    def clear_item_entities(self) -> None: ...
    def get_item_entity(self, entity_id: int) -> Optional[ItemEntity]: ...
    def get_item_entities(self) -> list[ItemEntity]: ...
    def item_entity_count(self) -> int: ...
    def pickup_item_entity(
        self, entity_id: int, inventory: Inventory, preferred_slot: int = 0xFFFFFFFF
    ) -> bool: ...
    def pickup_nearest_item(
        self,
        position: Vec3f,
        radius: float,
        inventory: Inventory,
        preferred_slot: int = 0xFFFFFFFF,
    ) -> bool: ...
    def update_items(self, delta_time: float) -> None: ...

    # Освещение и тактовое обновление мира
    def get_light_engine(self) -> LightEngine: ...
    def update_lighting(self) -> None: ...
    def update(self, delta_time: float) -> None: ...

    # Управление мешами
    def rebuild_chunk_mesh(self, chunk_pos: Vec2i) -> None: ...
    def rebuild_dirty_meshes(self) -> None: ...
    def set_mesh_update_callback(
        self, callback: Callable[[Vec2i, Mesh], None]
    ) -> None: ...
    def get_chunk_mesh(self, chunk_pos: Vec2i) -> Optional[Mesh]: ...
    def has_chunk_mesh(self, chunk_pos: Vec2i) -> bool: ...
    def mark_chunk_dirty(self, chunk_pos: Vec2i) -> None: ...
    def is_chunk_dirty(self, chunk_pos: Vec2i) -> bool: ...

    # Тики
    def tick_all(self, tick: int) -> None: ...
    def slow_tick(self, global_tick: int, tick_counter: int) -> None: ...

    # Доступ к менеджерам
    def get_tex_blocks_mgr(self) -> TextureBlocksManager: ...
    def get_tex_mgr(self) -> TextureManager: ...

    def __repr__(self) -> str: ...
