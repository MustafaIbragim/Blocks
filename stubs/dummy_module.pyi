from typing import Optional, overload

from collision_module import EntityCollision, TriggerCollision
from entity_module import Entity
from item_module import Inventory
from movement_module import GroundMover
from vec_module import Vec3f, Vec3i, Vec3r
from view_cam_module import ViewCam
from world_module import World


class Dummy(Entity):
    BLOCK_SIZE: float
    BODY_RADIUS: float
    BODY_HEIGHT: float
    CAPSULE_HEIGHT: float
    EYE_OFFSET: float
    MAX_PITCH: float

    view: ViewCam

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, position: Vec3f, rotation: Vec3r) -> None: ...

    @property
    def collisions_enabled(self) -> bool: ...
    @collisions_enabled.setter
    def collisions_enabled(self, value: bool) -> None: ...
    @property
    def gravity_enabled(self) -> bool: ...
    @gravity_enabled.setter
    def gravity_enabled(self, value: bool) -> None: ...
    @property
    def body(self) -> EntityCollision: ...
    @property
    def mover(self) -> GroundMover: ...
    step_height: float

    @overload
    def move_to(
        self,
        world: World,
        start: Vec3i,
        to: Vec3i,
        duration: float,
        step_height: Optional[float] = None,
    ) -> bool: ...
    @overload
    def move_to(
        self,
        world: World,
        to: Vec3i,
        duration: float,
        step_height: Optional[float] = None,
    ) -> bool: ...

    def update_movement(self, world: World, delta_time: float) -> bool: ...
    def move_towards(
        self,
        world: World,
        direction: Vec3f,
        speed: float,
        delta_time: float,
        step_height: Optional[float] = None,
    ) -> None: ...
    def stop_movement(self) -> None: ...
    def is_moving(self) -> bool: ...

    def set_view(self, view: ViewCam) -> None: ...
    def set_yaw(self, yaw: float) -> None: ...
    def get_yaw(self) -> float: ...
    def rotate_yaw(self, delta: float) -> None: ...
    def set_pitch(self, pitch: float) -> None: ...
    def get_pitch(self) -> float: ...
    def rotate_pitch(self, delta: float) -> None: ...
    def get_eye_position(self) -> Vec3f: ...

    @property
    def yaw(self) -> float: ...
    @yaw.setter
    def yaw(self, value: float) -> None: ...
    @property
    def pitch(self) -> float: ...
    @pitch.setter
    def pitch(self, value: float) -> None: ...

    def sync_view_from_transform(self) -> None: ...
    def sync_transform_from_view(self) -> None: ...
    def sync_body_from_transform(self) -> None: ...
    def sync_transform_from_body(self) -> None: ...
    def sync_view_from_body(self, alpha: float = 0.0) -> None: ...
    def set_collisions_enabled(self, enabled: bool) -> None: ...
    def set_gravity_enabled(self, enabled: bool) -> None: ...
    def toggle_physics(self) -> None: ...
    def update(self, tick: int, gravity: float = 0.0) -> None: ...

    def __repr__(self) -> str: ...


class DummyPickupTrigger(TriggerCollision):
    dummy: Dummy
    world: World
    inventory: Inventory
    preferred_slot: int

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        dummy: Dummy,
        world: World,
        inventory: Inventory,
        preferred_slot: int = 0xFFFFFFFF,
        radius: float = 4.0,
    ) -> None: ...

    def sync_bounds(self) -> None: ...
