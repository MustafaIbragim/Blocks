from __future__ import annotations

from typing import ClassVar, List, Optional, overload
from vec_module import Vec3i, Vertex, FaceData
from mesh_module import Mesh
from collision_module import CollisionMesh


class BlockNeighbor:
    block: Optional[Block]
    nbt: int
    is_cube: bool

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self, block: Optional[Block], nbt: int = 0, is_cube: bool = False
    ) -> None: ...

    def __repr__(self) -> str: ...


class BlockMeshData:
    vertices: List[Vertex]
    faces: List[FaceData]
    layers_are_texture_ids: bool

    def __init__(self) -> None: ...

    def add_vertex(self, vertex: Vertex) -> None: ...
    def add_face(self, face: FaceData) -> None: ...
    def clear(self) -> None: ...

    def __repr__(self) -> str: ...


class Block:
    NEIGHBOR_COUNT: ClassVar[int]
    LIGHT_CUBE_SIZE: ClassVar[int]

    id: int
    opacity: int
    light: int
    status: int
    name: str
    
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, id: int, name: str) -> None: ...

    def set_face_texture(self, face: int, texture_id: int) -> None: ...
    def get_face_texture(self, face: int, nbt: int = 0) -> int: ...
    
    def set_inner_mesh(self, mesh: Mesh) -> None: ...
    def get_inner_mesh(self, nbt: int = 0) -> Optional[Mesh]: ...

    def build_geometry(
        self,
        world_pos: Vec3i,
        nbt: int,
        neighbors: List[BlockNeighbor],
        light_cube: List[int],
    ) -> BlockMeshData: ...
    def build_cube_geometry(
        self,
        world_pos: Vec3i,
        nbt: int,
        neighbors: List[BlockNeighbor],
        light_cube: List[int],
    ) -> BlockMeshData: ...

    @staticmethod
    def light_cube_index(dx: int, dy: int, dz: int) -> int: ...
    @staticmethod
    def vertex_light_from_cube(
        light_cube: List[int], cx: int, cy: int, cz: int
    ) -> int: ...
    
    def build_collision_mesh_from_inner(self) -> None: ...
    def get_collision_mesh(self, nbt: int = 0) -> Optional[CollisionMesh]: ...
    def set_collision_mesh(self, mesh: CollisionMesh) -> None: ...
    def clear_collision_mesh(self) -> None: ...
    
    def is_solid(self, nbt: int = 0) -> bool: ...
    def has_collision(self, nbt: int = 0) -> bool: ...
    
    def on_place(self, pos: Vec3i, nbt: int = 0) -> int: ...
    def on_break(self, pos: Vec3i, nbt: int = 0) -> int: ...
    def on_interact(self, pos: Vec3i, nbt: int = 0) -> bool: ...
    def on_replace(self, pos: Vec3i, nbt: int = 0) -> int: ...
    def on_changed(self, pos: Vec3i, nbt: int = 0) -> int: ...
    def on_tick(self, pos: Vec3i, tick: int, nbt: int = 0) -> int: ...
    def on_slow_tick(self, pos: Vec3i, tick: int, nbt: int = 0) -> int: ...
    
    def __repr__(self) -> str: ...


class BlockManager:
    MAX_BLOCKS: int

    def __init__(self) -> None: ...
    
    def register_block(self, block: Block) -> int: ...
    def get_block(self, id: int) -> Optional[Block]: ...
    def has_block(self, id: int) -> bool: ...
    def size(self) -> int: ...
    def get_air_id(self) -> int: ...
    
    def __repr__(self) -> str: ...
