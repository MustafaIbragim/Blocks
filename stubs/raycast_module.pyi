from enum import Enum

from vec_module import Vec3f, Vec3i, Vec3r
from world_module import World


class Axis(str, Enum):
    NONE = "NONE"
    X = "X"
    Y = "Y"
    Z = "Z"


class RaycastHit:
    hit: bool
    block: Vec3i
    normal: Vec3i
    nbt: int
    distance: float

    def __bool__(self) -> bool: ...
    def __repr__(self) -> str: ...


class ViewDirections:
    def __init__(self, rotation: Vec3r) -> None: ...

    def set_rotation(self, rotation: Vec3r) -> None: ...
    @property
    def rotation(self) -> Vec3r: ...

    def create_forward(self, ignore_axis: Axis = Axis.NONE) -> Vec3f: ...
    def create_back(self, ignore_axis: Axis = Axis.NONE) -> Vec3f: ...
    def create_right(self, ignore_axis: Axis = Axis.NONE) -> Vec3f: ...
    def create_left(self, ignore_axis: Axis = Axis.NONE) -> Vec3f: ...
    def create_up(self, ignore_axis: Axis = Axis.NONE) -> Vec3f: ...
    def create_down(self, ignore_axis: Axis = Axis.NONE) -> Vec3f: ...

    def create_forward_flat(self) -> Vec3f: ...
    def create_back_flat(self) -> Vec3f: ...
    def create_right_flat(self) -> Vec3f: ...
    def create_left_flat(self) -> Vec3f: ...

    def create_forward_ignore_x(self) -> Vec3f: ...
    def create_forward_ignore_y(self) -> Vec3f: ...
    def create_forward_ignore_z(self) -> Vec3f: ...
    def create_right_ignore_x(self) -> Vec3f: ...
    def create_right_ignore_y(self) -> Vec3f: ...
    def create_right_ignore_z(self) -> Vec3f: ...
    def create_up_ignore_x(self) -> Vec3f: ...
    def create_up_ignore_y(self) -> Vec3f: ...
    def create_up_ignore_z(self) -> Vec3f: ...

    def __repr__(self) -> str: ...


def raycast_voxel(
    world: World,
    origin: Vec3f,
    direction: Vec3f,
    max_distance: float = 8.0,
) -> RaycastHit: ...
