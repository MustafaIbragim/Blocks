from typing import Optional, overload

from entity_module import Entity
from renderer_module import Renderer
from vec_module import Vec3f
from view_cam_module import ViewCam


class Camera(Entity):
    view: ViewCam
    renderer: Optional[Renderer]

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, renderer: Renderer) -> None: ...
    @overload
    def __init__(self, renderer: Renderer, view: ViewCam) -> None: ...

    def set_renderer(self, renderer: Renderer) -> None: ...
    def get_renderer(self) -> Optional[Renderer]: ...
    def set_view(self, view: ViewCam) -> None: ...
    def sync_view_from_transform(self) -> None: ...
    def sync_transform_from_view(self) -> None: ...
    def update(self, tick: int, gravity: float = 0.0) -> None: ...
    def render(
        self,
        current_tick: int,
        min_light: float = 0.1,
        day_light: float = 1.0,
    ) -> None: ...

    def __repr__(self) -> str: ...
