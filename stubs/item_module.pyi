from typing import Optional, overload

from block_module import Block
from collision_module import FragmentCollision
from entity_module import Entity
from image_module import Image
from mesh_module import Mesh
from movement_module import GroundMover
from vec_module import Vec3f, Vec3i
from world_module import World


class ItemActionContext:
    world: Optional[World]
    stack: ItemStack
    position: Vec3f
    block_position: Vec3i
    block_normal: Vec3i
    block_nbt: int
    has_block: bool

    def __init__(self) -> None: ...

    def __repr__(self) -> str: ...


class Item:
    name: str
    image: Optional[Image]
    mesh: Optional[Mesh]
    block: Optional[Block]
    stack_limit_code: int

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, name: str, image: Optional[Image] = None, max_stack: int = 1) -> None: ...

    @staticmethod
    def create_cube_mesh(size: float = 0.8) -> Mesh: ...

    @property
    def max_stack(self) -> int: ...
    @max_stack.setter
    def max_stack(self, value: int) -> None: ...

    def set_max_stack(self, value: int) -> None: ...
    def action_0(self, context: ItemActionContext) -> bool: ...
    def action_1(self, context: ItemActionContext) -> bool: ...

    def __repr__(self) -> str: ...


class ItemStack:
    item: Optional[Item]
    count: int

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, item: Item, count: int = 1) -> None: ...

    @property
    def max_stack(self) -> int: ...

    def empty(self) -> bool: ...
    def same_item(self, other: ItemStack) -> bool: ...
    def space(self) -> int: ...
    def add(self, amount: int) -> int: ...
    def remove(self, amount: int) -> int: ...
    def clear(self) -> None: ...

    def __repr__(self) -> str: ...


class Inventory:
    def __init__(self, slots: int = 0) -> None: ...

    def size(self) -> int: ...
    def resize(self, slots: int) -> None: ...
    def valid_slot(self, index: int) -> bool: ...
    def get_slot(self, index: int) -> ItemStack: ...
    def set_slot(self, index: int, stack: ItemStack) -> None: ...
    def add_to_slot(self, index: int, stack: ItemStack) -> int: ...
    def add(self, stack: ItemStack, preferred_slot: int = 0xFFFFFFFF) -> int: ...
    def take(self, index: int, count: int = 0) -> ItemStack: ...
    def can_accept(self, stack: ItemStack) -> bool: ...
    def count_of(self, item: Item) -> int: ...
    def empty(self) -> bool: ...
    def clear(self) -> None: ...

    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> ItemStack: ...

    def __repr__(self) -> str: ...


class ItemEntity(Entity):
    stack: ItemStack
    velocity: Vec3f
    pickup_delay: float
    alive: bool
    id: int
    sprite_size: float
    render_position: Vec3f
    render_mesh: Optional[Mesh]
    mesh_offset: Vec3f

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, stack: ItemStack, position: Vec3f = ..., velocity: Vec3f = ...) -> None: ...

    def sync_render_mesh(self) -> None: ...
    @property
    def collision_body(self) -> FragmentCollision: ...
    @property
    def mover(self) -> GroundMover: ...
    step_height: float

    @overload
    def move_to(
        self,
        world: World,
        start: Vec3i,
        to: Vec3i,
        duration: float,
        step_height: Optional[float] = None,
    ) -> bool: ...
    @overload
    def move_to(
        self,
        world: World,
        to: Vec3i,
        duration: float,
        step_height: Optional[float] = None,
    ) -> bool: ...

    def stop_movement(self) -> None: ...
    def is_moving(self) -> bool: ...
    def update(self, tick: int, gravity: float = 0.0) -> None: ...
    def can_pickup(self) -> bool: ...

    def __repr__(self) -> str: ...

