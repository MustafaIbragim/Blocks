from chunk_module import Chunk
from vec_module import Vec3i
from world_module import World


class LightEngine:
    LEVEL_COUNT: int
    CENTER: int

    def __init__(self, world: World) -> None: ...

    def update(self) -> None: ...
    def remove_light(self) -> None: ...
    def propagate_light(self) -> None: ...
    def mark_neighborhood(self, chunk: Chunk, local_pos: Vec3i) -> None: ...
    def mark_block_changed(
        self,
        chunk: Chunk,
        local_pos: Vec3i,
        old_opacity: int,
        new_opacity: int,
        old_light: int,
        new_light: int,
    ) -> None: ...
    def mark_chunk_sources(self, chunk: Chunk) -> None: ...
    def mark_chunk_border(self, chunk: Chunk, allow_decrease: bool = False) -> None: ...
    def forget_chunk(self, chunk: Chunk) -> None: ...
    def has_pending(self) -> bool: ...
    def has_dark_pending(self) -> bool: ...
    def has_light_pending(self) -> bool: ...
    def changed_nugget_count(self) -> int: ...
    def clear_changed_nuggets(self) -> None: ...
    def clear_queues(self) -> None: ...
