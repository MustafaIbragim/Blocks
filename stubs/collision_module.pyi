from enum import Enum
from typing import Optional, overload

from block_module import Block
from vec_module import Vec2i, Vec3f
from mesh_module import Mesh
from world_module import World


class MeshPurpose(str, Enum):
    PHYSICS = "PHYSICS"
    RENDER_ONLY = "RENDER_ONLY"


class CollisionType(str, Enum):
    STATIC = "STATIC"
    ENTITY = "ENTITY"
    FRAGMENT = "FRAGMENT"
    TRIGGER = "TRIGGER"


class Aabb:
    min: Vec3f
    max: Vec3f

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, min: Vec3f, max: Vec3f) -> None: ...

    @staticmethod
    def from_center_half(center: Vec3f, half_extents: Vec3f) -> Aabb: ...
    @staticmethod
    def invalid() -> Aabb: ...

    def valid(self) -> bool: ...
    def center(self) -> Vec3f: ...
    def half_extents(self) -> Vec3f: ...
    def overlaps(self, other: Aabb) -> bool: ...
    def touches(self, other: Aabb, epsilon: float = 1e-4) -> bool: ...
    def contact_normal(self, other: Aabb, epsilon: float = 1e-4) -> Vec3f: ...
    def penetration(self, other: Aabb) -> Vec3f: ...
    def translated(self, delta: Vec3f) -> Aabb: ...
    @overload
    def expanded(self, amount: float) -> Aabb: ...
    @overload
    def expanded(self, amount: Vec3f) -> Aabb: ...

    def __repr__(self) -> str: ...


def aabb_overlap(a: Aabb, b: Aabb) -> bool: ...
def aabb_touch(a: Aabb, b: Aabb, epsilon: float = 1e-4) -> bool: ...
def aabb_contact_normal(a: Aabb, b: Aabb, epsilon: float = 1e-4) -> Vec3f: ...
def aabb_penetration(moving: Aabb, other: Aabb) -> Vec3f: ...


class CollisionMesh:
    purpose: MeshPurpose

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, purpose: MeshPurpose) -> None: ...

    def physics_used(self) -> bool: ...
    def empty(self) -> bool: ...
    @overload
    def add_box(self, box: Aabb) -> None: ...
    @overload
    def add_box(self, min: Vec3f, max: Vec3f) -> None: ...
    def add_box_center(self, center: Vec3f, half_extents: Vec3f) -> None: ...
    def add_unit_cube(self) -> None: ...
    def clear(self) -> None: ...
    def bounds(self) -> Aabb: ...
    def world_bounds(self, origin: Vec3f) -> Aabb: ...
    @property
    def boxes(self) -> list[Aabb]: ...

    @staticmethod
    def unit_cube() -> CollisionMesh: ...
    @overload
    @staticmethod
    def box(min: Vec3f, max: Vec3f, purpose: MeshPurpose = MeshPurpose.PHYSICS) -> CollisionMesh: ...
    @overload
    @staticmethod
    def box(local_box: Aabb, purpose: MeshPurpose = MeshPurpose.PHYSICS) -> CollisionMesh: ...
    @staticmethod
    def box_aabb(local_box: Aabb, purpose: MeshPurpose = MeshPurpose.PHYSICS) -> CollisionMesh: ...
    @staticmethod
    def from_mesh(mesh: Mesh, purpose: MeshPurpose = MeshPurpose.PHYSICS) -> CollisionMesh: ...

    def __repr__(self) -> str: ...


class CollisionObject:
    id: int
    enabled: bool

    def type(self) -> CollisionType: ...
    def get_bounds(self) -> Aabb: ...
    def is_static(self) -> bool: ...
    def is_entity(self) -> bool: ...
    def is_fragment(self) -> bool: ...
    def is_trigger(self) -> bool: ...


class StaticCollision(CollisionObject):
    position: Vec3f
    mesh: Optional[CollisionMesh]

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, position: Vec3f, mesh: CollisionMesh) -> None: ...

    def blocks_physics(self) -> bool: ...


class DynamicCollision(CollisionObject):
    position: Vec3f
    half_extents: Vec3f
    velocity: Vec3f
    mass: float
    collisions_enabled: bool
    gravity_enabled: bool
    grounded: bool
    walled: bool
    interpolation_ticks: float

    def is_grounded(self) -> bool: ...
    def is_walled(self) -> bool: ...
    def get_bounds(self) -> Aabb: ...
    def get_swept_bounds(self, delta: Vec3f) -> Aabb: ...
    def set_position(self, position: Vec3f, reset_history: bool = True) -> None: ...
    def set_half_extents(self, half_extents: Vec3f) -> None: ...
    def record_history(self) -> None: ...
    def reset_history(self) -> None: ...
    def set_interpolation_ticks(self, value: float) -> None: ...
    def history_size(self) -> int: ...
    def get_render_position(self, alpha: float = 0.0) -> Vec3f: ...
    def inverse_mass(self) -> float: ...


class EntityCollision(DynamicCollision):
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, half_extents: Vec3f, position: Vec3f, mass: float = 1.0) -> None: ...


class FragmentCollision(DynamicCollision):
    source_id: int

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, half_extents: Vec3f, position: Vec3f, mass: float = 0.1) -> None: ...


class TriggerCollision(CollisionObject):
    position: Vec3f
    half_extents: Vec3f
    name: str
    inside: set[int]
    entered: list[int]
    exited: list[int]

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, position: Vec3f, half_extents: Vec3f, name: str = "") -> None: ...

    def get_bounds(self) -> Aabb: ...
    def contains_id(self, object_id: int) -> bool: ...
    def on_enter(self, other: CollisionObject) -> None: ...
    def on_exit(self, other: CollisionObject) -> None: ...


class CollisionWorld:
    def __init__(self) -> None: ...

    def set_world(self, world: World) -> None: ...
    def clear_world(self) -> None: ...
    def add_chunk(self, world: World, chunk_pos: Vec2i) -> None: ...
    def remove_chunk(self, chunk_pos: Vec2i) -> None: ...
    def has_chunk(self, chunk_pos: Vec2i) -> bool: ...
    def clear_chunks(self) -> None: ...

    def add_static(self, object: StaticCollision) -> int: ...
    @overload
    def add_static_box(self, min: Vec3f, max: Vec3f) -> int: ...
    @overload
    def add_static_box(self, box: Aabb) -> int: ...
    @overload
    def add_static_aabb(self, box: Aabb) -> int: ...
    def get_static(self, object_id: int) -> Optional[StaticCollision]: ...
    def remove_static(self, object_id: int) -> None: ...
    def clear_statics(self) -> None: ...

    @overload
    def add_entity(self, half_extents: Vec3f, position: Vec3f, mass: float = 1.0) -> int: ...
    @overload
    def add_entity(self, body: EntityCollision) -> int: ...
    def get_entity(self, object_id: int) -> Optional[EntityCollision]: ...
    def remove_entity(self, object_id: int) -> None: ...
    def clear_entities(self) -> None: ...

    @overload
    def add_fragment(self, half_extents: Vec3f, position: Vec3f, mass: float = 0.1) -> int: ...
    @overload
    def add_fragment(self, body: FragmentCollision) -> int: ...
    def get_fragment(self, object_id: int) -> Optional[FragmentCollision]: ...
    def remove_fragment(self, object_id: int) -> None: ...
    def clear_fragments(self) -> None: ...

    def add_trigger(self, object: TriggerCollision) -> int: ...
    def add_trigger_box(self, position: Vec3f, half_extents: Vec3f, name: str = "") -> int: ...
    def get_trigger(self, object_id: int) -> Optional[TriggerCollision]: ...
    def remove_trigger(self, object_id: int) -> None: ...
    def clear_triggers(self) -> None: ...
    def clear_all(self) -> None: ...

    def set_gravity(self, gravity: Vec3f) -> None: ...
    def get_gravity(self) -> Vec3f: ...
    def step(self, delta_time: float, max_substeps: int = 8, fixed_time_step: float = 1.0 / 60.0) -> None: ...
    def step_fragments(self, delta_time: float) -> None: ...

    def get_num_collision_objects(self) -> int: ...
    def get_num_contacts(self) -> int: ...
    def get_num_manifolds(self) -> int: ...

    def get_entity_position(self, object_id: int) -> Vec3f: ...
    def get_entity_render_position(self, object_id: int, alpha: float = 0.0) -> Vec3f: ...
    def get_entity_velocity(self, object_id: int) -> Vec3f: ...
    def is_entity_grounded(self, object_id: int) -> bool: ...
    def is_entity_walled(self, object_id: int) -> bool: ...
    def set_entity_position(self, object_id: int, position: Vec3f) -> None: ...


def set_block_collision_mesh(block: Block, mesh: CollisionMesh) -> None: ...
def get_block_collision_mesh(block: Block, nbt: int = 0) -> Optional[CollisionMesh]: ...
def clear_block_collision_mesh(block: Block) -> None: ...
def block_has_collision(block: Block, nbt: int = 0) -> bool: ...

def step_fragment_against_world(world: CollisionWorld, body: FragmentCollision, delta_time: float, gravity: Vec3f = ...) -> None: ...
