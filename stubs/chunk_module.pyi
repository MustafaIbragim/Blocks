from enum import Enum
from typing import Optional, overload

import numpy as np

from block_module import Block, BlockManager
from vec_module import Vec2i, Vec3i


class ChunkNeighborDir(str, Enum):
    NegX = "NegX"
    PosX = "PosX"
    NegZ = "NegZ"
    PosZ = "PosZ"


class ChunkNugget:
    SIZE: int
    BLOCKS_COUNT: int

    def __init__(self, parent: Optional[Chunk] = None, y_idx: int = 0) -> None: ...

    def get_block_id(self, x: int, y: int, z: int) -> int: ...
    def set_block_id(self, x: int, y: int, z: int, id: int) -> None: ...

    # --- NBT: обычное 16-битное число на клетку ---
    def get_nbt(self, x: int, y: int, z: int) -> int: ...
    def set_nbt(self, x: int, y: int, z: int, nbt: int) -> None: ...
    def get_nbt_by_index(self, index: int) -> int: ...
    def set_nbt_by_index(self, index: int, nbt: int) -> None: ...

    @overload
    def get_block(self, x: int, y: int, z: int, block_mgr: BlockManager) -> Optional[Block]: ...
    @overload
    def get_block(self, pos: Vec3i, block_mgr: BlockManager) -> Optional[Block]: ...
    @overload
    def set_block(self, x: int, y: int, z: int, block: Block) -> None: ...
    @overload
    def set_block(self, pos: Vec3i, block: Block) -> None: ...

    @staticmethod
    def coords_to_index(x: int, y: int, z: int) -> int: ...
    @staticmethod
    def index_to_coords(index: int) -> Vec3i: ...

    def add_tick_block(self, local_index: int) -> None: ...
    def remove_tick_block(self, local_index: int) -> None: ...
    def add_slow_tick_block(self, local_index: int) -> None: ...
    def remove_slow_tick_block(self, local_index: int) -> None: ...

    @property
    def block_ids_np(self) -> np.ndarray: ...
    @property
    def nbt_data_np(self) -> np.ndarray: ...

    def __repr__(self) -> str: ...


class Chunk:
    NUGGETS_COUNT: int
    SIZE_XZ: int
    HEIGHT: int
    VOLUME: int
    FLAG_WORDS: int

    chunk_xz: Vec2i

    def __init__(self) -> None: ...
    def __init__(self, xz: Vec2i = ...) -> None: ...

    def set_neighbor(self, dir: ChunkNeighborDir, neighbor: Chunk) -> None: ...
    def get_neighbor(self, dir: ChunkNeighborDir) -> Optional[Chunk]: ...
    def clear_neighbors(self) -> None: ...

    def get_block_id(self, x: int, y: int, z: int) -> int: ...
    def set_block_id(self, x: int, y: int, z: int, id: int) -> None: ...

    @overload
    def get_block(self, x: int, y: int, z: int, block_mgr: BlockManager) -> Optional[Block]: ...
    @overload
    def get_block(self, pos: Vec3i, block_mgr: BlockManager) -> Optional[Block]: ...
    def get_block_fast(self, x: int, y: int, z: int, block_mgr: BlockManager) -> Optional[Block]: ...
    @overload
    def set_block(self, x: int, y: int, z: int, block: Block) -> None: ...
    @overload
    def set_block(self, pos: Vec3i, block: Block) -> None: ...

    # --- NBT ---
    @overload
    def get_nbt(self, x: int, y: int, z: int) -> int: ...
    @overload
    def get_nbt(self, pos: Vec3i) -> int: ...
    @overload
    def set_nbt(self, x: int, y: int, z: int, nbt: int) -> None: ...
    @overload
    def set_nbt(self, pos: Vec3i, nbt: int) -> None: ...

    def get_opacity(self, x: int, y: int, z: int) -> int: ...
    def set_opacity(self, x: int, y: int, z: int, value: int) -> None: ...

    def get_light(self, x: int, y: int, z: int) -> int: ...
    def set_light(self, x: int, y: int, z: int, value: int) -> None: ...

    def is_light_dirty(self, global_index: int) -> bool: ...
    def mark_light_dirty(self, global_index: int, state: bool) -> None: ...
    def clear_all_light_dirty(self) -> None: ...

    def is_standard_cube(self, global_index: int) -> bool: ...
    def set_standard_cube(self, global_index: int, state: bool) -> None: ...

    @staticmethod
    def coords_to_global_index(x: int, y: int, z: int) -> int: ...
    def local_to_world(self, x: int, y: int, z: int) -> Vec3i: ...

    def tick_all(self, tick: int, block_mgr: BlockManager) -> None: ...
    def slow_tick(self, global_tick: int, tick_counter: int, block_mgr: BlockManager) -> None: ...

    @property
    def nuggets(self) -> list[ChunkNugget]: ...
    @property
    def opacity_np(self) -> np.ndarray: ...
    @property
    def light_np(self) -> np.ndarray: ...
    @property
    def light_queue_level_np(self) -> np.ndarray: ...
    @property
    def light_dirty_np(self) -> np.ndarray: ...
    @property
    def cube_flags_np(self) -> np.ndarray: ...

    def __repr__(self) -> str: ...
