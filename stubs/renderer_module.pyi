from typing import Optional, overload

from image_module import Image
from mesh_module import Mesh
from texture_module import TextureBlocksManager
from vec_module import Vec3f
from view_cam_module import ViewCam

# ViewCam живёт в отдельном модуле; биндинг оставляет алиас для совместимости.
__all__ = ["Sprite", "MeshInstance", "Renderer", "ViewCam"]


class Sprite:
    position: Vec3f
    size: float
    texture_id: int

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, position: Vec3f, size: float = 0.5, texture_id: int = 0) -> None: ...

    def __repr__(self) -> str: ...


class MeshInstance:
    mesh: Optional[Mesh]
    position: Vec3f
    scale: Vec3f
    texture_id: int

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(
        self,
        mesh: Mesh,
        position: Vec3f,
        scale: Vec3f = ...,
        texture_id: int = 0,
    ) -> None: ...

    def __repr__(self) -> str: ...


class Renderer:
    def __init__(self) -> None: ...

    def init(self, width: int, height: int, title: str) -> None: ...
    def cleanup(self) -> None: ...
    def upload_block_textures(self, tex_blocks_mgr: TextureBlocksManager) -> None: ...
    def upload_texture(self, texture_id: int, img: Image) -> None: ...
    def remove_texture(self, texture_id: int) -> None: ...
    def upload_mesh(self, mesh_id: int, mesh: Mesh) -> None: ...
    def remove_mesh(self, mesh_id: int) -> None: ...
    def render(
        self,
        current_tick: int,
        camera: ViewCam,
        min_light: float,
        day_light: float = 1.0,
    ) -> None: ...
    def render_meshes(
        self, instances: list[MeshInstance], camera: ViewCam, min_light: float = 0.1
    ) -> None: ...
    def render_sprites(self, sprites: list[Sprite], camera: ViewCam) -> None: ...
    def render_screen_texture(
        self, texture_id: int, x: float, y: float, w: float, h: float
    ) -> None: ...
    def should_close(self) -> bool: ...
    def poll_events(self) -> None: ...
    def swap_buffers(self) -> None: ...
    def get_width(self) -> int: ...
    def get_height(self) -> int: ...
    def get_window_handle(self) -> int: ...

    def __repr__(self) -> str: ...
