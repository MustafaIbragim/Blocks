from typing import overload
from vec_module import Vec2i, Vec2f, Vec4u8


class Image:
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def channels(self) -> int: ...
    
    def __init__(self, width: int, height: int) -> None: ...
    
    @overload
    def get_pixel(self, x: int, y: int) -> Vec4u8: ...
    @overload
    def get_pixel(self, pos: Vec2i) -> Vec4u8: ...
    @overload
    def get_pixel(self, pos: Vec2f) -> Vec4u8: ...
    
    @overload
    def set_pixel(self, x: int, y: int, color: Vec4u8) -> None: ...
    @overload
    def set_pixel(self, pos: Vec2i, color: Vec4u8) -> None: ...
    @overload
    def set_pixel(self, pos: Vec2f, color: Vec4u8) -> None: ...
    
    def fill(self, color: Vec4u8) -> None: ...
    
    def __repr__(self) -> str: ...


