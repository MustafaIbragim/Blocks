from typing import Tuple



class Input:
    def __init__(self, window_handle: int) -> None: ...

    def is_key_pressed(self, key: int) -> bool: ...
    def is_key_just_pressed(self, key: int) -> bool: ...
    def is_key_just_released(self, key: int) -> bool: ...
    def is_mouse_button_pressed(self, button: int) -> bool: ...
    def is_mouse_button_just_pressed(self, button: int) -> bool: ...
    def is_mouse_button_just_released(self, button: int) -> bool: ...
    def get_mouse_delta(self) -> Tuple[float, float]: ...
    def set_cursor_visible(self, visible: bool) -> None: ...
    def poll_events(self) -> None: ...

    def __repr__(self) -> str: ...


MOUSE_BUTTON_LEFT: int
MOUSE_BUTTON_RIGHT: int
MOUSE_BUTTON_MIDDLE: int
